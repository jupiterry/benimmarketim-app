<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ bulut yedeği ve cihazdan cihaza aktarım. Ayrıntı için
     backup_rules.xml: şifreli token kaydı Keystore anahtarı olmadan
     çözülemez, bu yüzden aktarılmaz. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
